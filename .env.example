# EligiCore — example environment configuration
#
# Copy to .env and adjust for your machine:   cp .env.example .env
#
# .env is git-ignored and MUST NEVER be committed. This file contains placeholders only —
# never put a real secret here (standards/security_privacy.md §5).

# --- Application ---
ELIGICORE_APP_NAME=EligiCore
ELIGICORE_ENVIRONMENT=development
ELIGICORE_DEBUG=false

# --- API ---
ELIGICORE_API_V1_PREFIX=/api/v1

# --- Operational database ---
# Holds the job catalogue, ingestion state and operational logs ONLY.
# Candidate personal data is never stored here (ADR-001, ADR-011).
# SQLite in development; a PostgreSQL URL in production (ADR-009).
ELIGICORE_DATABASE_URL=sqlite:///./eligicore.db

# --- Logging ---
# Safe operational metadata only: request id, method, path, status, duration.
# Never candidate payloads, resume contents or PII (INV-4).
ELIGICORE_LOG_LEVEL=INFO

# --- Payload bounds ---
ELIGICORE_MAX_EDUCATION_ENTRIES=20
ELIGICORE_MAX_EXPERIENCE_ENTRIES=50
ELIGICORE_MAX_SKILLS=200

# --- AI provider ---
# Phase 1 default provider: Google Gemini Flash (ADR-013).
# Gemini is the concrete Phase 1 implementation, NOT an architectural dependency — all AI
# access goes through app/ai/providers/base.py (INV-5), and swapping providers is a change
# to this variable plus one new provider class.
#
# Default is `mock`, deliberately. An unconfigured checkout and CI must never be able to
# make a paid API call by accident. The test suite always runs with no key set.
ELIGICORE_AI_PROVIDER=mock

# Set to `gemini` and supply a key for live extraction:
#   ELIGICORE_AI_PROVIDER=gemini
#
# NEVER put a real key in this file. It belongs in .env, which is git-ignored.
ELIGICORE_GEMINI_API_KEY=

# Model identifier, kept configurable so the model can change without touching source.
# NOTE: this default has not been verified against a live API from this environment.
# Confirm the current identifier in Google's documentation before first live use.
ELIGICORE_GEMINI_MODEL=gemini-2.0-flash

# Request timeout and retry cap. An unbounded retry loop against a paid API is a
# financial bug, not just a reliability one.
ELIGICORE_AI_TIMEOUT_SECONDS=30
ELIGICORE_AI_MAX_RETRIES=2
